# MMM Studio — Local & Cloud Configuration

# PostgreSQL connection string (Procrastinate + SQLAlchemy)
MMM_DATABASE_URL=postgresql:///mmm_studio?host=/tmp&port=5433

# Storage backend (`local` or `gcs`)
MMM_STORAGE_BACKEND=local
MMM_LOCAL_DATA_DIR=.app_data
MMM_GCS_BUCKET=

# Optional access code guarding write/compute actions (`POST /runs`, `/start`, `/forecasts`, `/optimisations`)
MMM_APP_ACCESS_CODE=

# Queue depth cap for Meridian jobs
MMM_MAX_MERIDIAN_QUEUED=3

# Cloud Run Job wakeup (set true in Cloud Run production)
MMM_WAKE_WORKERS=false
MMM_GCP_PROJECT=formare-dev
MMM_GCP_REGION=europe-west3
MMM_WORKER_ANALYSIS_JOB=mmm-studio-worker-analysis
MMM_WORKER_MERIDIAN_JOB=mmm-studio-worker-meridian
MMM_WORKER_INTERACTIVE_JOB=mmm-studio-worker-interactive
