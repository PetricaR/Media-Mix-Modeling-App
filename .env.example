# MMM Studio — Local & Cloud Configuration

# PostgreSQL connection string (Procrastinate + SQLAlchemy)
MMM_DATABASE_URL=postgresql:///mmm_studio?host=/tmp&port=5433

# Storage backend (`local` or `gcs`)
MMM_STORAGE_BACKEND=local
MMM_LOCAL_DATA_DIR=.app_data
MMM_GCS_BUCKET=

# development | production. Production refuses to start without an access code of at least 16 characters.
MMM_ENV=development

# Studio access code: when set, every route except /api/v1/health needs it (sign-in sets an HttpOnly session cookie;
# API clients may send the X-Access-Code header). Empty = open, for local development only.
MMM_APP_ACCESS_CODE=
MMM_SESSION_TTL_HOURS=12

# Proxies that append to X-Forwarded-For in front of the API (Cloud Run front end + nginx sidecar = 2; local = 0)
MMM_TRUSTED_PROXY_HOPS=0

# Wall-clock limit of one Meridian fit in a worker (seconds)
MMM_MERIDIAN_FIT_TIMEOUT_SECONDS=3600

# Queue depth cap for Meridian jobs
MMM_MAX_MERIDIAN_QUEUED=3

# Cloud Run Job wakeup (set true in Cloud Run production)
MMM_WAKE_WORKERS=false
MMM_GCP_PROJECT=your-gcp-project
MMM_GCP_REGION=europe-west3
MMM_WORKER_ANALYSIS_JOB=mmm-studio-worker-analysis
MMM_WORKER_MERIDIAN_JOB=mmm-studio-worker-meridian
MMM_WORKER_INTERACTIVE_JOB=mmm-studio-worker-interactive

# Gemini "Explain" buttons on every chart and table. Either an API key from Google AI Studio …
MMM_GEMINI_API_KEY=
# … or Vertex AI with your Google credentials (gcloud auth application-default login) in MMM_GCP_PROJECT
MMM_GEMINI_VERTEX=false
MMM_GEMINI_LOCATION=global
MMM_GEMINI_MODEL=gemini-4-argon
# New (uncached) explanations per client and minute
MMM_EXPLAIN_PER_MINUTE=20
